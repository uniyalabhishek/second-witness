{
  "name": "second-witness",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test \"core/test/*.test.ts\" \"reader/test/*.test.ts\" \"witness/test/*.test.ts\" \"feed/test/*.test.ts\" \"extension/test/*.test.ts\" \"replay/test/*.test.ts\" \"demo-site/test/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "demo": "PORT=8787 node demo-site/server.mjs",
    "witness": "node --env-file=.env witness/src/run.ts --key",
    "build": "node extension/build.mjs && node feed/build.mjs",
    "site": "node deploy-site.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@arkiv-network/sdk": "^1.0.1",
    "viem": "^2.57.16"
  }
}
